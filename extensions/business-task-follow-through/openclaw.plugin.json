{
  "id": "business-task-follow-through",
  "name": "Business Task Follow-through",
  "description": "Durable business command ownership, dependency continuation, and terminal notification.",
  "enabledByDefault": false,
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "notificationTarget": {
        "type": "string",
        "minLength": 1
      },
      "agents": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "required": [
      "notificationTarget"
    ]
  },
  "contracts": {
    "tools": [
      "business_task_checkpoint",
      "business_task_review"
    ]
  }
}
